{
  "name": "appsec-kb",
  "version": "0.1.0",
  "private": true,
  "description": "Knowledge base interativa de segurança de software: mapas por domínio (AppSec, CloudSec, agentes de IA, SecOps e Engenharia de segurança), trilhas, cenários e quizzes.",
  "license": "MIT",
  "author": {
    "name": "Vitor Sienna",
    "url": "https://www.linkedin.com/in/vitor-sienna/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/S1ENN4/appsec-kb.git"
  },
  "bugs": {
    "url": "https://github.com/S1ENN4/appsec-kb/issues"
  },
  "homepage": "https://github.com/S1ENN4/appsec-kb#readme",
  "keywords": [
    "appsec",
    "devsecops",
    "cloud-security",
    "secops",
    "waf",
    "ai-security",
    "knowledge-base",
    "nextjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --import ./scripts/content-alias-loader.mjs scripts/validate-content.mjs",
    "build": "next build && node scripts/check-budget.mjs",
    "mcp": "node --import ./scripts/content-alias-loader.mjs mcp/server.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.4.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
